{
  "ConnectionStrings": {
    "DocumentProcessing": "Server=(localdb)\\MSSQLLocalDB;Database=DocumentProcessing;Integrated Security=True;TrustServerCertificate=True;Encrypt=False"
  },
  "Storage": {
    "RootPath": "App_Data/documents"
  },
  "Workflow": {
    "MaxRetryAttempts": 3,
    "ToolTimeoutMilliseconds": 30000,
    "OcrDelayMinMilliseconds": 1000,
    "OcrDelayMaxMilliseconds": 3000,
    "MaxUploadBytes": 5242880,
    "LockLeaseSeconds": 180,
    "RecoveryPollSeconds": 15,
    "EnableRecoveryHost": true
  },
  "Ocr": {
    "Provider": "Mock",
    "DefaultScenario": "SuccessFirstAttempt",
    "TimeoutSimulationMilliseconds": 60000
  }
}
